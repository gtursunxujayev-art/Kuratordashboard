# Database — same PostgreSQL as Dashboarduz
# Neon/Prisma: allow enough time for an idle compute to wake up.
DATABASE_URL=postgresql://user:password@host/dbname?connect_timeout=30&pool_timeout=30

# JWT — must match Dashboarduz JWT_SECRET if sharing sessions, or use a different one
JWT_SECRET=change-me-in-production-minimum-32-characters
JWT_EXPIRES_IN=7d

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000

# Telegram report bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
REPORT_CRON_SECRET=
REPORT_TIMEZONE=Asia/Tashkent

# Dashboarduz payment receipt gateway
# Dashboarduz must expose POST /debug/telegram with TELEGRAM_DEBUG_KEY configured.
DASHBOARDUZ_API_URL=
DASHBOARDUZ_TELEGRAM_ENDPOINT=
# Must match Dashboarduz TELEGRAM_DEBUG_KEY.
DASHBOARDUZ_TELEGRAM_SECRET=
# Required payment receipt target; multiple IDs may be comma-separated.
DASHBOARDUZ_PAYMENT_GROUP_ID=
DASHBOARDUZ_PAYMENT_GROUP_IDS=

# Face ID student attendance webhook
FACEID_WEBHOOK_SECRET=
FACEID_TENANT_ID=
